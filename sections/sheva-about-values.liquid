{% comment %} ============================================================
  SHEVA TEA — Values Section
  Shows values with icons and description cards.
============================================================ {% endcomment %}

{{ 'sheva-about.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

<style>
  #sheva-about-values-{{ section.id }} {
    --sec-pt: {{ s.padding_top }}px;
    --sec-pb: {{ s.padding_bottom }}px;
    --about-eyebrow-color: {{ s.eyebrow_color }};
    --val-title-color: {{ s.title_color }};
    --val-card-title-color: {{ s.card_title_color }};
    --val-card-desc-color: {{ s.card_desc_color }};
    --val-icon-from: {{ s.icon_bg_from }};
    --val-icon-to: {{ s.icon_bg_to }};
  }
  #sheva-about-values-{{ section.id }} .sheva-values-grid {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  #sheva-about-values-{{ section.id }} .sheva-sec-title {
    color: var(--val-title-color);
  }
  #sheva-about-values-{{ section.id }} .sheva-value-card h4 {
    color: var(--val-card-title-color);
  }
  #sheva-about-values-{{ section.id }} .sheva-value-card p {
    color: var(--val-card-desc-color);
  }
  #sheva-about-values-{{ section.id }} .sheva-value-icon {
    background: linear-gradient(135deg, var(--val-icon-from), var(--val-icon-to));
  }
</style>

<section id="sheva-about-values-{{ section.id }}" class="sheva-about-section">
  <div class="sheva-about-sec-head">
    {%- if s.eyebrow != blank -%}
      <span class="sheva-eyebrow">{{ s.eyebrow }}</span>
    {%- endif -%}
    {%- if s.title != blank -%}
      <h2 class="sheva-sec-title">{{ s.title }}</h2>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="sheva-values-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'value_card' -%}
          <div class="sheva-value-card" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="sheva-value-icon">{{ block.settings.icon }}</div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h4>{{ block.settings.title }}</h4>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p>{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Sheva — Values",
  "tag": "section",
  "class": "sheva-section-about-values",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "✦ WHAT WE STAND FOR"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Values that guide the ritual"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#22d3ee"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Section Title Color",
      "default": "#f3f0ff"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_desc_color",
      "label": "Card Description Color",
      "default": "#f3f0ff"
    },
    {
      "type": "color",
      "id": "icon_bg_from",
      "label": "Icon Gradient Background From",
      "default": "rgba(255,77,184,0.25)"
    },
    {
      "type": "color",
      "id": "icon_bg_to",
      "label": "Icon Gradient Background To",
      "default": "rgba(34,211,238,0.25)"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "value_card",
      "name": "Value Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Emoji or character)",
          "default": "✨"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Experience"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "From the first glance to the final sip, everything is designed to feel elevated."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sheva — Values",
      "blocks": [
        {
          "type": "value_card",
          "settings": {
            "icon": "♻️",
            "title": "Sustainability",
            "description": "We care about conscious materials, responsible packaging, and long-term impact."
          }
        },
        {
          "type": "value_card",
          "settings": {
            "icon": "✨",
            "title": "Premium Experience",
            "description": "From the first glance to the final sip, everything is designed to feel elevated."
          }
        },
        {
          "type": "value_card",
          "settings": {
            "icon": "💫",
            "title": "Daily Ritual",
            "description": "We believe small habits can shape your mood, your focus, and your mindset."
          }
        },
        {
          "type": "value_card",
          "settings": {
            "icon": "🌌",
            "title": "Cosmic Identity",
            "description": "Our universe is bold, dreamy, and a little surreal — because your brand should be too."
          }
        }
      ]
    }
  ]
}
{% endschema %}
