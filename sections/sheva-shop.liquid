

{{ 'sheva-shop.css' | asset_url | stylesheet_tag }}

{%- assign layout = section.settings.layout_type | default: 'marquee' -%}
{%- assign section_id = 'sheva-shop-' | append: section.id -%}

<section
  id="sheva-shop"
  class="sheva-shop{% if layout == 'slider' %} sheva-shop--slider{% endif %}"
  style="
    --shop-pad-top: {{ section.settings.padding_top }}px;
    --shop-pad-bottom: {{ section.settings.padding_bottom }}px;
    --shop-speed: {{ section.settings.slider_speed }}s;
    --shop-card-w: {{ section.settings.card_width }}px;
  "
>

  {%- comment %} ── Section Header ── {% endcomment %}
  <div class="sheva-sec-head">
    {%- if section.settings.eyebrow != blank -%}
      <span class="sheva-eyebrow" style="color: {{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="sheva-sec-title"
        style="font-size: clamp({{ section.settings.title_fs_mobile }}px, 4vw, {{ section.settings.title_fs_desktop }}px);">
        {%- if section.settings.title_plain != blank -%}{{ section.settings.title_plain }} {%- endif -%}
        <em class="sheva-glow">{{ section.settings.title }}</em>
      </h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="sheva-sec-sub" style="font-size: {{ section.settings.sub_fs }}px;">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>

  {%- comment %} ────────────────────────────────
    A. BUNDLE HERO
  ──────────────────────────────── {% endcomment %}
  {%- if section.settings.show_bundle -%}
    {%- assign bundle_prod = section.settings.bundle_product -%}
    {%- assign bundle_tag_text = section.settings.bundle_tag -%}
    {%- if bundle_prod != blank and bundle_prod != empty -%}
      {%- assign bundle_var = bundle_prod.selected_or_first_available_variant -%}
      {%- assign now_price = bundle_var.price | money -%}

      {%- if bundle_var.compare_at_price > bundle_var.price -%}
        {%- assign was_price = bundle_var.compare_at_price | money -%}
        {%- assign save_val = bundle_var.compare_at_price | minus: bundle_var.price -%}
        {%- assign save_amount = save_val | money -%}
        {%- assign save_pill_text = 'Save ' | append: save_amount -%}
      {%- else -%}
        {%- assign was_price = '' -%}
        {%- assign save_pill_text = '' -%}
      {%- endif -%}
    {%- else -%}
      {%- assign now_price = section.settings.bundle_now -%}
      {%- assign was_price = section.settings.bundle_was -%}
      {%- assign save_pill_text = section.settings.bundle_save -%}
    {%- endif -%}

    <div class="sheva-bundle"
      style="margin-bottom: {{ section.settings.bundle_mb }}px;">

      {%- comment -%} Left: Text {%- endcomment -%}
      <div class="sheva-bundle__left">
        {%- if bundle_tag_text != blank -%}
          <span class="sheva-bundle__tag"
            style="font-size: {{ section.settings.bundle_tag_fs }}px;">{{ bundle_tag_text }}</span>
        {%- endif -%}

        <h3 class="sheva-bundle__title"
          style="font-size: clamp({{ section.settings.bundle_title_fs_mb }}px, 3.4vw, {{ section.settings.bundle_title_fs }}px);">
          {%- if section.settings.bundle_title_plain != blank -%}{{ section.settings.bundle_title_plain }} {%- endif -%}
          <em class="sheva-glow">{{ section.settings.bundle_title }}</em>
        </h3>

        {%- if section.settings.bundle_desc != blank -%}
          <p class="sheva-bundle__desc"
            style="font-size: {{ section.settings.bundle_desc_fs }}px;">{{ section.settings.bundle_desc }}</p>
        {%- endif -%}

        {%- assign bundle_items = section.blocks | where: 'type', 'bundle_item' -%}
        {%- if bundle_items.size > 0 -%}
          <ul class="sheva-bundle__list">
            {%- for block in bundle_items -%}
              <li style="font-size: {{ section.settings.bundle_list_fs }}px;" {{ block.shopify_attributes }}>
                {{ block.settings.emoji }} {{ block.settings.label }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- assign bundle_link = section.settings.bundle_btn_link -%}
        {%- if bundle_link == blank and bundle_prod != blank -%}
          {%- assign bundle_link = bundle_prod.url -%}
        {%- endif -%}

        {%- if bundle_prod != blank and bundle_prod != empty and bundle_prod.variants.size > 1 -%}
          <div class="sheva-bundle__variant-box">
            <label for="sheva-bundle-select-{{ section.id }}" class="sheva-bundle__variant-label">Select Option:</label>
            <select id="sheva-bundle-select-{{ section.id }}" class="sheva-bundle__variant-select js-sheva-bundle-variant-select" aria-label="Select Variant">
              {%- for variant in bundle_prod.variants -%}
                {%- assign v_save_amt = '' -%}
                {%- if variant.compare_at_price > variant.price -%}
                  {%- assign v_save_val = variant.compare_at_price | minus: variant.price -%}
                  {%- assign v_save_amt = v_save_val | money -%}
                {%- endif -%}
                {%- assign v_url = section.settings.bundle_btn_link | default: variant.url -%}
                <option
                  value="{{ variant.id }}"
                  data-price="{{ variant.price | money }}"
                  data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                  data-save-pill="{% if variant.compare_at_price > variant.price %}Save {{ v_save_amt }}{% endif %}"
                  data-url="{{ v_url }}"
                  data-available="{{ variant.available }}"
                  {% if variant == bundle_var %}selected{% endif %}
                >
                  {{ variant.title }} - {{ variant.price | money }}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}

        <div class="sheva-bundle__price">
          <span class="sheva-bundle__was" style="font-size: {{ section.settings.bundle_was_fs }}px;{% if was_price == blank %} display: none;{% endif %}">{{ was_price }}</span>
          <span class="sheva-bundle__now" style="font-size: clamp(28px, 4vw, {{ section.settings.bundle_now_fs }}px);">{{ now_price }}</span>
          <span class="sheva-bundle__save-pill" style="font-size: {{ section.settings.bundle_save_fs }}px;{% if save_pill_text == blank %} display: none;{% endif %}">{{ save_pill_text }}</span>
        </div>

        {%- if section.settings.bundle_btn_label != blank -%}
          <a href="{{ bundle_link }}" class="sheva-btn-primary sheva-bundle__btn">
            {{ section.settings.bundle_btn_label }}
          </a>
        {%- endif -%}

        {%- if section.settings.bundle_footnote != blank -%}
          <p class="sheva-bundle__foot"
            style="font-size: {{ section.settings.bundle_foot_fs }}px;">{{ section.settings.bundle_footnote }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} Right: Animated orb + floating emojis {%- endcomment -%}
      <div class="sheva-bundle__right">
        <div class="sheva-bundle__orb"></div>
        <div class="sheva-bundle__ring"></div>
        <div class="sheva-bundle__ring sheva-bundle__ring--r2"></div>
        <div class="sheva-bundle__emoji-stack">
          {% if section.settings.product_image != blank %}
            <div class="sheva-bundle__image_wrapper">
              <img src="{{ section.settings.product_image | img_url:'master' }}" height="100%" width="100%" alt="{{ section.settings.product_image.alt }}"/>
            </div>
          {% elsif bundle_prod.featured_image != blank %}
            <div class="sheva-bundle__image_wrapper">
              <img src="{{ bundle_prod.featured_image | img_url:'master' }}" height="100%" width="100%" alt="{{ bundle_prod.featured_image.alt }}"/>
            </div>
          {% endif %}
          {%- assign be_index = 0 -%}
          {%- for block in bundle_items limit: 7 -%}
            {%- assign be_index = be_index | plus: 1 -%}
            <span class="sheva-be sheva-be{{ be_index }}" aria-hidden="true">{{ block.settings.emoji }}</span>
          {%- endfor -%}
        </div>
      </div>

    </div>
  {%- endif -%}

  {%- comment %} ────────────────────────────────
    B. SHOP CARD CAROUSEL (Marquee or Slider)
  ──────────────────────────────── {% endcomment %}
  {%- assign shop_cards = section.blocks | where: 'type', 'shop_card' -%}

  {%- comment %} ── Shared card snippet ── {% endcomment %}
  {%- capture shop_card_html -%}
    {%- for block in shop_cards -%}
      {%- assign card_prod = block.settings.card_product -%}
      {%- assign card_price = block.settings.price -%}
      {%- assign card_link = block.settings.product_link -%}

      {%- if card_prod != blank and card_prod != empty -%}
        {%- assign card_var = card_prod.selected_or_first_available_variant -%}
        {%- if card_price == blank -%}
          {%- assign card_price = card_var.price | money -%}
        {%- endif -%}
        {%- if card_link == blank -%}
          {%- assign card_link = card_prod.url -%}
        {%- endif -%}
      {%- endif -%}

      <div class="sheva-shop-card" {{ block.shopify_attributes }}>
        {%- assign badge_display = block.settings.badge -%}
        {%- if card_prod != blank and card_prod != empty -%}
          {%- assign badge_display = card_prod.tags.first -%}
        {%- endif -%}
        {%- if badge_display != blank -%}
          <div class="sheva-shop-badge{% if block.settings.badge_alt %} sheva-shop-badge--alt{% endif %}"
            style="font-size: {{ section.settings.badge_fs }}px;">{{ badge_display }}</div>
        {%- endif -%}

        {%- if card_link != blank -%}
          <a href="{{ card_link }}" class="sheva-shop-img-link">
        {%- endif -%}
        <div class="sheva-shop-img {{ block.settings.gradient_class }}"
          style="height: {{ section.settings.card_img_h }}px;">
          {%- if card_prod.featured_image != blank and block.settings.emoji == blank -%}
            <img src="{{ card_prod.featured_image | img_url: '400x' }}" alt="{{ card_prod.title }}" class="sheva-shop-card-img" />
          {%- else -%}
            <span class="sheva-shop-emoji" style="font-size: {{ section.settings.card_emoji_fs }}px;">{{ block.settings.emoji }}</span>
          {%- endif -%}
        </div>
        {%- if card_link != blank -%}
          </a>
        {%- endif -%}

        <div class="sheva-shop-info">
          {%- if block.settings.category != blank -%}
            <span class="sheva-shop-cat" style="font-size: {{ section.settings.cat_fs }}px;">{{ block.settings.category }}</span>
          {%- endif -%}
          <h4 class="sheva-shop-name" style="font-size: {{ section.settings.card_name_fs }}px;">
            {%- if card_link != blank -%}
              <a href="{{ card_link }}" style="color: inherit; text-decoration: none;">{{ block.settings.name | default: card_prod.title }}</a>
            {%- else -%}
              {{ block.settings.name }}
            {%- endif -%}
          </h4>
          <p class="sheva-shop-desc" style="font-size: {{ section.settings.card_desc_fs }}px;">{{ block.settings.description }}</p>

          <div class="sheva-shop-foot">
            <span class="sheva-shop-price" style="font-size: {{ section.settings.price_fs }}px;">{{ card_price }}</span>

            {%- if card_prod != blank and card_prod != empty -%}
              {%- if card_prod.available -%}
                <product-form class="sheva-shop-card__form">
                  {%- assign card_form_id = 'sheva-card-form-' | append: block.id -%}
                  {%- form 'product', card_prod, id: card_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                    <input type="hidden" name="id" value="{{ card_var.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button
                      type="submit"
                      name="add"
                      data-btn-addToCart
                      class="sheva-btn-ghost sheva-btn-ghost--sm sheva-shop-atc-btn"
                      style="font-size: {{ section.settings.card_btn_fs }}px;"
                    >
                      ADD +
                    </button>
                  {%- endform -%}
                </product-form>
              {%- else -%}
                <button
                  type="button"
                  class="sheva-btn-ghost sheva-btn-ghost--sm sheva-shop-atc-btn is-soldout"
                  style="font-size: {{ section.settings.card_btn_fs }}px; pointer-events: none; opacity: 0.5;"
                  disabled="disabled"
                >
                  SOLD OUT
                </button>
              {%- endif -%}
            {%- elsif card_link != blank -%}
              <a href="{{ card_link }}" class="sheva-btn-ghost sheva-btn-ghost--sm sheva-shop-atc-btn"
                style="font-size: {{ section.settings.card_btn_fs }}px;">ADD +</a>
            {%- else -%}
              <a href="/collections/all" class="sheva-btn-ghost sheva-btn-ghost--sm sheva-shop-atc-btn"
                style="font-size: {{ section.settings.card_btn_fs }}px;">ADD +</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  {%- endcapture -%}

  {%- if shop_cards.size > 0 -%}

    {%- if layout == 'marquee' -%}
      {%- comment %} ════════════ MARQUEE ════════════ {% endcomment %}
      {%- assign marquee_dir = section.settings.marquee_direction | default: 'rtl' -%}
      {%- assign pause_class = '' -%}
      {%- if section.settings.pause_on_hover -%}
        {%- assign pause_class = ' sheva-shop-pause-hover' -%}
      {%- endif -%}
      <div class="sheva-shop-slider js-sheva-auto-slider{{ pause_class }}"
        data-direction="{{ marquee_dir }}">
        <div class="sheva-shop-track sheva-shop-track--{{ marquee_dir }}">
          {{ shop_card_html }}
          {%- comment -%} Duplicate pass — seamless loop {%- endcomment -%}
          {{ shop_card_html }}
        </div>
      </div>

    {%- else -%}
      {%- comment %} ════════════ SLIDER — powered by Slick Carousel ════════════ {% endcomment %}
      <div class="sheva-shop-swiper" id="{{ section_id }}" data-section-id="{{ section.id }}">
        <div class="sheva-shop-swiper__track"
          data-dots="{{ section.settings.show_dots }}"
          data-arrows="{{ section.settings.show_arrows }}"
          data-slides-show="3"
          data-slides-md="2">
          {{ shop_card_html }}
        </div>
        {%- if section.settings.show_dots -%}
          <div class="sheva-swiper-dots" role="tablist"></div>
        {%- endif -%}
      </div>
    {%- endif -%}

  {%- endif -%}

</section>

{%- if layout == 'slider' -%}
<script>
  $(document).ready(function () {
    $('#sheva-shop-{{ section.id }} .sheva-shop-swiper__track').slick({
      dots: {{ section.settings.show_dots }},
      arrows: {{ section.settings.show_arrows }},
      infinite: true,
      autoplay: true,
      autoplaySpeed: 3000,
      speed: 300,
      slidesToShow: 3,
      slidesToScroll: 1,
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 1
          }
        },
        {
          breakpoint: 600,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1
          }
        }
      ]
    });
  });
</script>
{%- endif -%}

<script>
  (function() {
    function initBundleVariantSelect() {
      var sectionEl = document.getElementById('sheva-shop');
      if (!sectionEl) return;
      var select = sectionEl.querySelector('.js-sheva-bundle-variant-select');
      if (!select) return;

      select.addEventListener('change', function() {
        var opt = this.options[this.selectedIndex];
        if (!opt) return;

        var price = opt.getAttribute('data-price');
        var comparePrice = opt.getAttribute('data-compare-price');
        var savePill = opt.getAttribute('data-save-pill');
        var url = opt.getAttribute('data-url');
        var isAvailable = opt.getAttribute('data-available') === 'true';

        var nowEl = sectionEl.querySelector('.sheva-bundle__now');
        var wasEl = sectionEl.querySelector('.sheva-bundle__was');
        var saveEl = sectionEl.querySelector('.sheva-bundle__save-pill');
        var btn = sectionEl.querySelector('.sheva-bundle__btn');

        if (nowEl && price) nowEl.textContent = price;

        if (wasEl) {
          if (comparePrice) {
            wasEl.textContent = comparePrice;
            wasEl.style.display = 'inline-block';
          } else {
            wasEl.style.display = 'none';
          }
        }

        if (saveEl) {
          if (savePill) {
            saveEl.textContent = savePill;
            saveEl.style.display = 'inline-block';
          } else {
            saveEl.style.display = 'none';
          }
        }

        if (btn && url) {
          btn.setAttribute('href', url);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBundleVariantSelect);
    } else {
      initBundleVariantSelect();
    }
    document.addEventListener('shopify:section:load', initBundleVariantSelect);
  })();
</script>

{% schema %}
{
  "name": "Sheva – Shop Collection",
  "tag": "section",
  "class": "sheva-section sheva-shop-section",
  "max_blocks": 30,
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "✦ THE TITAN AURA COLLECTION"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#22d3ee"
    },
    {
      "type": "text",
      "id": "title_plain",
      "label": "Title – Plain Part",
      "default": "Shop the"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title – Gradient Part",
      "default": "Cosmos"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Curated cosmic essentials designed to align your ritual."
    },
    {
      "type": "range",
      "id": "title_fs_desktop",
      "label": "Title Size – Desktop (px)",
      "min": 24,
      "max": 72,
      "step": 1,
      "default": 52
    },
    {
      "type": "range",
      "id": "title_fs_mobile",
      "label": "Title Size – Mobile (px)",
      "min": 18,
      "max": 48,
      "step": 1,
      "default": 28
    },
    {
      "type": "range",
      "id": "sub_fs",
      "label": "Subtitle Font Size (px)",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 15
    },
    {
      "type":"image_picker",
      "id":"product_image",
      "label":"Image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout Type",
      "options": [
        { "value": "marquee", "label": "Marquee (auto-scroll)" },
        { "value": "slider",  "label": "Slider (manual)" }
      ],
      "default": "marquee"
    },
    {
      "type": "header",
      "content": "Marquee Settings"
    },
    {
      "type": "paragraph",
      "content": "These settings apply when Layout Type is set to Marquee."
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "Scroll Direction",
      "options": [
        { "value": "rtl", "label": "Right → Left" },
        { "value": "ltr", "label": "Left → Right" }
      ],
      "default": "rtl"
    },
    {
      "type": "range",
      "id": "slider_speed",
      "label": "Scroll Speed (seconds – lower = faster)",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 55
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "paragraph",
      "content": "These settings apply when Layout Type is set to Slider."
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Dot Navigation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Prev / Next Arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "Bundle Hero"
    },
    {
      "type": "checkbox",
      "id": "show_bundle",
      "label": "Show Bundle Hero",
      "default": true
    },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Bundle Product (Optional)",
      "info": "Select a product to automatically link prices, compare price, savings badge, variants, and Add to Cart."
    },
    {
      "type": "text",
      "id": "bundle_tag",
      "label": "Bundle Tag",
      "default": "✦ BEST VALUE · SAVE 28%"
    },
    {
      "type": "range",
      "id": "bundle_tag_fs",
      "label": "Bundle Tag Font Size (px)",
      "min": 9,
      "max": 16,
      "step": 1,
      "default": 11
    },
    {
      "type": "text",
      "id": "bundle_title_plain",
      "label": "Bundle Title – Plain Part",
      "default": "Titan Aura"
    },
    {
      "type": "text",
      "id": "bundle_title",
      "label": "Bundle Title – Gradient Part",
      "default": "Complete Bundle"
    },
    {
      "type": "range",
      "id": "bundle_title_fs",
      "label": "Bundle Title Size – Desktop (px)",
      "min": 20,
      "max": 60,
      "step": 1,
      "default": 46
    },
    {
      "type": "range",
      "id": "bundle_title_fs_mb",
      "label": "Bundle Title Size – Mobile (px)",
      "min": 18,
      "max": 40,
      "step": 1,
      "default": 26
    },
    {
      "type": "textarea",
      "id": "bundle_desc",
      "label": "Bundle Description",
      "default": "Seven cosmic essentials in one stellar collection — your daily ritual, fully aligned with the stars."
    },
    {
      "type": "range",
      "id": "bundle_desc_fs",
      "label": "Bundle Desc Font Size (px)",
      "min": 12,
      "max": 18,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "bundle_list_fs",
      "label": "Bundle List Font Size (px)",
      "min": 10,
      "max": 16,
      "step": 1,
      "default": 13
    },
    {
      "type": "text",
      "id": "bundle_was",
      "label": "Was Price",
      "default": "$108.51"
    },
    {
      "type": "range",
      "id": "bundle_was_fs",
      "label": "Was Price Font Size (px)",
      "min": 14,
      "max": 26,
      "step": 1,
      "default": 20
    },
    {
      "type": "text",
      "id": "bundle_now",
      "label": "Now Price",
      "default": "$77.77"
    },
    {
      "type": "range",
      "id": "bundle_now_fs",
      "label": "Now Price Font Size – Desktop (px)",
      "min": 24,
      "max": 56,
      "step": 2,
      "default": 38
    },
    {
      "type": "text",
      "id": "bundle_save",
      "label": "Save Pill Text",
      "default": "Save $30.74"
    },
    {
      "type": "range",
      "id": "bundle_save_fs",
      "label": "Save Pill Font Size (px)",
      "min": 9,
      "max": 16,
      "step": 1,
      "default": 12
    },
    {
      "type": "text",
      "id": "bundle_btn_label",
      "label": "Bundle CTA Label",
      "default": "Claim the Bundle →"
    },
    {
      "type": "url",
      "id": "bundle_btn_link",
      "label": "Bundle CTA Link"
