{% comment %} ============================================================
  SHEVA TEA — Marquee Bar Section
  Gradient strip with infinite scrolling text. Right → Left.
============================================================ {% endcomment %}

{{ 'sheva-marquee-bar.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign text        = section.settings.marquee_text
  assign speed       = section.settings.speed
  assign grad_from   = section.settings.grad_from
  assign grad_mid    = section.settings.grad_mid
  assign grad_to     = section.settings.grad_to
  assign text_color  = section.settings.text_color
  assign font_size   = section.settings.font_size
  assign font_size_mb= section.settings.font_size_mb
  assign pad_top     = section.settings.padding_top
  assign pad_bottom  = section.settings.padding_bottom
-%}

<div
  class="sheva-mq-bar js-sheva-auto-slider"
  style="
    --mq-grad: linear-gradient(90deg, {{ grad_from }}, {{ grad_mid }}, {{ grad_to }});
    --mq-color: {{ text_color }};
    {% comment %} --mq-fs: {{ font_size }}px;
    --mq-fs-mb: {{ font_size_mb }}px; {% endcomment %}
    --mq-fs: clamp({{ font_size_mb }}px, 2vw, {{ font_size }}px);
    --mq-speed: {{ speed }}s;
    --mq-pt: {{ pad_top }}px;
    --mq-pb: {{ pad_bottom }}px;
  "
  aria-hidden="true"
>
  {%- comment -%} Two identical spans = seamless CSS infinite loop {%- endcomment -%}
  {%- comment -%} Text duplicated twice for seamless looping {%- endcomment -%}
  <div class="sheva-mq-track">
    <span class="sheva-mq-text">{{ text }}</span>
    <span class="sheva-mq-text" aria-hidden="true">{{ text }}</span>
  </div>
</div>

{% schema %}
{
  "name": "Sheva – Marquee Bar",
  "tag": "section",
  "class": "sheva-section sheva-marquee-bar-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Marquee Text",
      "default": "✦ SEVEN STAR ENERGY ✦ COSMIC HERBAL TEA ✦ THE STARS ARE ALIGNING ✦ SHEVA TEA ✦ SUPERNOVA ✦ SEVEN STAR ENERGY ✦ COSMIC HERBAL TEA ✦ THE STARS ARE ALIGNING ✦ SHEVA TEA ✦ SUPERNOVA ✦"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll Speed (seconds – lower = faster)",
      "min": 10,
      "max": 80,
      "step": 5,
      "default": 30
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size – Desktop (px)",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "font_size_mb",
      "label": "Font Size – Mobile (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "grad_from",
      "label": "Gradient – From",
      "default": "#ff4db8"
    },
    {
      "type": "color",
      "id": "grad_mid",
      "label": "Gradient – Mid",
      "default": "#ff7a3d"
    },
    {
      "type": "color",
      "id": "grad_to",
      "label": "Gradient – To",
      "default": "#8b5cf6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Sheva – Marquee Bar"
    }
  ]
}
{% endschema %}
