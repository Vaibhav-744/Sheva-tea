{{ 'sheva-contact.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

<style>
  #sheva-contact-faq-{{ section.id }} {
    --sec-pt: {{ s.padding_top }}px;
    --sec-pb: {{ s.padding_bottom }}px;
    --eyebrow-color: {{ s.eyebrow_color }};
    --eyebrow-fs: {{ s.eyebrow_size }}px;
    --title-color: {{ s.title_color }};
    --title-fs-desktop: {{ s.title_fs_desktop }}px;
    --title-fs-mobile: {{ s.title_fs_mobile }}px;
  }
</style>

<section
  id="sheva-contact-faq-{{ section.id }}"
  class="contact-faq sheva-contact-faq"
>
  <div id="faq"></div>
  <div class="sec-head sheva-contact-faq-head">
    {%- if s.eyebrow != blank -%}
      <span class="eyebrow sheva-eyebrow">
        {{ s.eyebrow }}
      </span>
    {%- endif -%}

    {%- if s.title != blank -%}
      <h2 class="section-title">
        {{ s.title }}
      </h2>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="faq-list sheva-faq-list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_item' -%}
          <details class="faq-item sheva-faq-item" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <p>{{ block.settings.answer }}</p>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Sheva — Contact FAQ",
  "tag": "section",
  "class": "sheva-section-contact-faq",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "✦ QUICK ANSWERS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Before you write"
    },
    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow Font Size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_fs_desktop",
      "label": "Title Font Size Desktop (px)",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "title_fs_mobile",
      "label": "Title Font Size Mobile (px)",
      "min": 16,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#22d3ee"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#f3f0ff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does shipping take?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Domestic orders ship within 1–2 business days and typically arrive in 3–6 days. Free shipping applies on orders over $50."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sheva — Contact FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "Domestic orders ship within 1–2 business days and typically arrive in 3–6 days. Free shipping applies on orders over $50."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Can I change or cancel my subscription?",
            "answer": "Yes. Subscriptions can be paused, rescheduled, or cancelled anytime — just email us with your order number."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Do you offer wholesale or bulk pricing?",
            "answer": "We do. Choose 'Wholesale Inquiry' in the form above and include your store name, location, and expected volume."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Is Supernova Tea caffeine-free?",
            "answer": "Supernova is a caffeine-free herbal blend. Its energy comes from adaptogenic botanicals, not stimulants."
          }
        }
      ]
    }
  ]
}
{% endschema %}
