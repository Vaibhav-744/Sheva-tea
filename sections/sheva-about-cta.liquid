{{ 'sheva-about.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

<style>
  #sheva-about-cta-{{ section.id }} {
    --sec-pt: {{ s.padding_top }}px;
    --sec-pb: {{ s.padding_bottom }}px;
    --eyebrow-color: {{ s.eyebrow_color }};
    --eyebrow-fs: {{ s.eyebrow_size }}px;
    --cta-title-color: {{ s.title_color }};
    --cta-title-fs-desktop: {{ s.title_fs_desktop }}px;
    --cta-title-fs-mobile: {{ s.title_fs_mobile }}px;
    --cta-sub-color: {{ s.subtitle_color }};
    --cta-sub-fs: {{ s.sub_fs }}px;
    --btn-from: {{ s.btn_color_from }};
    --btn-to: {{ s.btn_color_to }};
    --btn-text-color: {{ s.btn_text_color }};
  }
</style>

<section
  id="sheva-about-cta-{{ section.id }}"
  class="sheva-about-cta"
>
  {%- if s.eyebrow != blank -%}
    <span class="sheva-eyebrow eyebrow">
      {{ s.eyebrow }}
    </span>
  {%- endif -%}

  {%- if s.title != blank -%}
    <h2>
      {{ s.title }}
    </h2>
  {%- endif -%}

  {%- if s.subtitle != blank -%}
    <p>
      {{ s.subtitle }}
    </p>
  {%- endif -%}

  {%- if s.btn_label != blank -%}
    <a href="{{ s.btn_url }}" class="sheva-btn-primary">{{ s.btn_label }}</a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Sheva — About CTA",
  "tag": "section",
  "class": "sheva-section-about-cta",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Ready to step into the Sheva Tea universe?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Explore the collection and make your daily ritual feel cosmic."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow Font Size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_fs_desktop",
      "label": "Title Font Size Desktop (px)",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "title_fs_mobile",
      "label": "Title Font Size Mobile (px)",
      "min": 16,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "sub_fs",
      "label": "Subtitle Font Size (px)",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#22d3ee"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#f3f0ff"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#f3f0ff"
    },
    {
      "type": "color",
      "id": "btn_color_from",
      "label": "Button Gradient From",
      "default": "#ff4db8"
    },
    {
      "type": "color",
      "id": "btn_color_to",
      "label": "Button Gradient To",
      "default": "#8b5cf6"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Sheva — About CTA"
    }
  ]
}
{% endschema %}
