{{ 'sheva-about.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

<style>
  #sheva-about-story-{{ section.id }} {
    --sec-pt: {{ s.padding_top }}px;
    --sec-pb: {{ s.padding_bottom }}px;
    --eyebrow-color: {{ s.eyebrow_color }};
    --eyebrow-fs: {{ s.eyebrow_size }}px;
    --title-color: {{ s.title_color }};
    --title-fs-desktop: {{ s.title_fs_desktop }}px;
    --title-fs-mobile: {{ s.title_fs_mobile }}px;
    --story-card-title-color: {{ s.card_title_color }};
    --story-card-desc-color: {{ s.card_desc_color }};
  }
</style>

<section
  id="sheva-about-story-{{ section.id }}"
  class="sheva-about-section"
>
  <div class="sheva-about-sec-head">
    {%- if s.eyebrow != blank -%}
      <span class="sheva-eyebrow eyebrow">
        {{ s.eyebrow }}
      </span>
    {%- endif -%}
    {%- if s.title != blank -%}
      <h2 class="sheva-sec-title">
        {{ s.title }}
      </h2>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="sheva-about-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'story_card' -%}
          <div class="sheva-about-card" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h3>{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p>{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Sheva — Our Story",
  "tag": "section",
  "class": "sheva-section-about-story",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "✦ OUR STORY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "From a daily ritual to a cosmic brand"
    },
    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow Font Size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_fs_desktop",
      "label": "Title Font Size Desktop (px)",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "title_fs_mobile",
      "label": "Title Font Size Mobile (px)",
      "min": 16,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#22d3ee"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Section Title Color",
      "default": "#f3f0ff"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_desc_color",
      "label": "Card Description Color",
      "default": "#f3f0ff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "story_card",
      "name": "Story Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Our Mission"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "To create products that support energy, mindfulness, and self-expression while making every part of the ritual feel elevated and personal."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sheva — Our Story",
      "blocks": [
        {
          "type": "story_card",
          "settings": {
            "title": "Our Mission",
            "description": "To create products that support energy, mindfulness, and self-expression while making every part of the ritual feel elevated and personal."
          }
        },
        {
          "type": "story_card",
          "settings": {
            "title": "Our Vision",
            "description": "To build a world where tea, stationery, and lifestyle objects are not just functional, but inspiring symbols of who you are and what you value."
          }
        },
        {
          "type": "story_card",
          "settings": {
            "title": "Our Energy",
            "description": "Seven Star Energy® is our way of turning intention into design — blending cosmic imagery, vibrant color, and a sense of wonder into every experience."
          }
        }
      ]
    }
  ]
}
{% endschema %}
