{% comment %} ============================================================
  SHEVA TEA — Featured In / Press Section
  Supports multiple press links via blocks.
============================================================ {% endcomment %}

{{ 'sheva-featured-in.css' | asset_url | stylesheet_tag }}

<section
  class="sheva-featured"
  style="
    --feat-pad-top: {{ section.settings.padding_top }}px;
    --feat-pad-bottom: {{ section.settings.padding_bottom }}px;
    --feat-heading-color: {{ section.settings.heading_color }};
    --feat-link-color: {{ section.settings.link_color }};
  "
>
  {%- if section.settings.heading != blank -%}
    <h3 class="sheva-featured__heading"
      style="font-size: {{ section.settings.heading_fs }}px; letter-spacing: {{ section.settings.heading_ls }}px;">
      {{ section.settings.heading }}
    </h3>
  {%- endif -%}

  <div class="sheva-featured__links">
    {%- for block in section.blocks -%}
      {%- if block.type == 'press_link' -%}
        {%- if block.settings.url != blank -%}
          <a
            href="{{ block.settings.url }}"
            target="_blank"
            rel="noopener noreferrer"
            class="sheva-featured__link"
            style="font-size: {{ section.settings.link_fs }}px;"
            {{ block.shopify_attributes }}
          >{{ block.settings.label }}</a>
        {%- else -%}
          <span class="sheva-featured__link"
            style="font-size: {{ section.settings.link_fs }}px;"
            {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Sheva – Featured In",
  "tag": "section",
  "class": "sheva-section sheva-featured-in-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "✦ Featured In ✦"
    },
    {
      "type": "range",
      "id": "heading_fs",
      "label": "Heading Font Size (px)",
      "min": 12,
      "max": 28,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_ls",
      "label": "Heading Letter Spacing (px)",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "link_fs",
      "label": "Link Font Size (px)",
      "min": 11,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#22d3ee"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#ff4db8"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 20,
      "max": 120,
      "step": 2,
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 20,
      "max": 120,
      "step": 2,
      "default": 70
    }
  ],
  "blocks": [
    {
      "type": "press_link",
      "name": "Press Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Display Text",
          "default": "NY Weekly Magazine — Top 30 Inspirational Women"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sheva – Featured In",
      "blocks": [
        {
          "type": "press_link",
          "settings": {
            "label": "NY Weekly Magazine — Top 30 Inspirational Women"
          }
        }
      ]
    }
  ]
}
{% endschema %}
