{{ 'sheva-about.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

<style>
  #sheva-about-hero-{{ section.id }} {
    --sec-pt: {{ s.padding_top }}px;
    --sec-pb: {{ s.padding_bottom }}px;
    --eyebrow-color: {{ s.eyebrow_color }};
    --eyebrow-fs: {{ s.eyebrow_size }}px;
    --headline-color: {{ s.description_color }};
    --headline-fs-desktop: {{ s.headline_fs_desktop }}px;
    --headline-fs-mobile: {{ s.headline_fs_mobile }}px;
    --desc-fs: {{ s.desc_fs }}px;
    --desc-color: {{ s.description_color }};
    --grad-from: {{ s.headline_grad_from }};
    --grad-mid: {{ s.headline_grad_mid }};
    --grad-to: {{ s.headline_grad_to }};
    --btn-from: {{ s.btn1_color_from }};
    --btn-to: {{ s.btn1_color_to }};
    --btn-text-color: {{ s.btn1_text_color }};
    --btn-ghost-color: {{ s.btn2_text_color }};
    --btn-ghost-border: {{ s.btn2_border_color }};
  }
</style>

<div class="sheva-about-hero-wrapper">
  {%- if s.vertical_text != blank -%}
    <div class="abt-vert">{{ s.vertical_text }}</div>
  {%- endif -%}

  <section
    id="sheva-about-hero-{{ section.id }}"
    class="sheva-about-hero abt-hero"
  >
    <div class="sheva-about-hero__content abt-hero-copy">
      {%- if s.eyebrow != blank -%}
        <span class="sheva-about-hero__eyebrow eyebrow">
          {{ s.eyebrow }}
        </span>
      {%- endif -%}

      {%- if s.headline != blank -%}
        <h1 class="sheva-about-hero__headline sheva-glow-text">
          {{ s.headline }}
        </h1>
      {%- endif -%}

      {%- if s.description != blank -%}
        <p class="sheva-about-hero__desc">
          {{ s.description }}
        </p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="abt-hero-meta">
          {%- for block in section.blocks -%}
            {%- if block.type == 'stat_item' -%}
              <div {{ block.shopify_attributes }}>
                <strong>{{ block.settings.number }}</strong>
                <span>{{ block.settings.label }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if s.btn1_label != blank or s.btn2_label != blank -%}
        <div class="sheva-about-hero__btns">
          {%- if s.btn1_label != blank -%}
            <a href="{{ s.btn1_url }}" class="sheva-btn-primary">{{ s.btn1_label }}</a>
          {%- endif -%}
          {%- if s.btn2_label != blank -%}
            <a href="{{ s.btn2_url }}" class="sheva-btn-ghost">{{ s.btn2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="sheva-about-hero__art abt-hero-art" aria-hidden="true">
      <div class="sheva-about-orb abt-halo"></div>
      {%- if s.hero_image != blank -%}
        <img
          src="{{ s.hero_image | img_url: '600x' }}"
          alt="{{ s.hero_image.alt | default: 'Sheva Tea Supernova herbal tea' }}"
          class="sheva-about-pack abt-pack"
          loading="eager"
          width="300"
          height="auto"
        />
      {%- else -%}
        <img
          src="{{ 'hero-cast.webp' | asset_url }}"
          alt="Sheva Tea Supernova herbal tea"
          class="sheva-about-pack abt-pack"
          loading="eager"
          width="300"
          height="auto"
        />
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Sheva — About Hero",
  "tag": "section",
  "class": "sheva-section-about-hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "vertical_text",
      "label": "Vertical Brand Watermark",
      "default": "SHEVA TEA®"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "✦ ABOUT SHEVA TEA®"
    },
    {
      "type": "richtext",
      "id": "headline",
      "label": "Headline",
      "default": "<p>Unique blends that <em>delight the palate</em> and promote well-being.</p>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Sheva Tea® is dedicated to providing unique blends that not only delight the palate but also promote well-being — a ritual crafted for the body, mind, and spirit."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow Font Size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "headline_fs_desktop",
      "label": "Headline Font Size Desktop (px)",
      "min": 28,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "headline_fs_mobile",
      "label": "Headline Font Size Mobile (px)",
      "min": 20,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "desc_fs",
      "label": "Description Font Size (px)",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Button 1 (Primary)"
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Button 1 Label"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button 1 Link"
    },
    {
      "type": "header",
      "content": "Button 2 (Ghost)"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Button 2 Label"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Button 2 Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#22d3ee"
    },
    {
      "type": "color",
      "id": "headline_grad_from",
      "label": "Headline Gradient From",
      "default": "#ff4db8"
    },
    {
      "type": "color",
      "id": "headline_grad_mid",
      "label": "Headline Gradient Mid",
      "default": "#ff7a3d"
    },
    {
      "type": "color",
      "id": "headline_grad_to",
      "label": "Headline Gradient To",
      "default": "#22d3ee"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#f3f0ff"
    },
    {
      "type": "color",
      "id": "btn1_color_from",
      "label": "Primary Button Gradient From",
      "default": "#ff4db8"
    },
    {
      "type": "color",
      "id": "btn1_color_to",
      "label": "Primary Button Gradient To",
      "default": "#8b5cf6"
    },
    {
      "type": "color",
      "id": "btn1_text_color",
      "label": "Primary Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn2_text_color",
      "label": "Ghost Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn2_border_color",
      "label": "Ghost Button Border Color",
      "default": "#ffffff4d"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "stat_item",
      "name": "Stat Item",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Stat Number/Value",
          "default": "50+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Stat Label",
          "default": "Sacred herbs"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sheva — About Hero",
      "blocks": [
        {
          "type": "stat_item",
          "settings": {
            "number": "50+",
            "label": "Sacred herbs"
          }
        },
        {
          "type": "stat_item",
          "settings": {
            "number": "7",
            "label": "Chakras recharged"
          }
        },
        {
          "type": "stat_item",
          "settings": {
            "number": "100%",
            "label": "Ethically sourced"
          }
        }
      ]
    }
  ]
}
{% endschema %}
