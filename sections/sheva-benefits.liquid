{% comment %} ============================================================
  SHEVA TEA — Benefits Grid Section
  Auto-fit grid of benefit cards with hover shimmer.
  All cards are blocks — fully editable in theme editor.
============================================================ {% endcomment %}

{{ 'sheva-benefits.css' | asset_url | stylesheet_tag }}

<section
  id="sheva-benefits"
  class="sheva-benefits"
  style="
    --ben-pad-top: {{ section.settings.padding_top }}px;
    --ben-pad-bottom: {{ section.settings.padding_bottom }}px;
    --ben-eyebrow-color: {{ section.settings.eyebrow_color }};
    --ben-card-border-hover: {{ section.settings.card_hover_border }};
    --ben-card-shadow-hover: {{ section.settings.card_hover_shadow | color_modify: 'alpha', 0.3 }};
  "
>

  {%- comment %} ── Section Header ── {% endcomment %}
  <div class="sheva-sec-head">
    {%- if section.settings.eyebrow != blank -%}
      <span class="sheva-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2
        class="sheva-sec-title"
        style="font-size: clamp({{ section.settings.title_fs_mobile }}px, 4vw, {{ section.settings.title_fs_desktop }}px);"
      >
        {%- if section.settings.title_plain != blank -%}
          {{ section.settings.title_plain }}
          <em class="sheva-glow">{{ section.settings.title }}</em>
        {%- else -%}
          {{ section.settings.title }}
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="sheva-sec-sub"
        style="font-size: {{ section.settings.sub_fs }}px;">
        {{ section.settings.subtitle }}
      </p>
    {%- endif -%}
  </div>

  {%- comment %} ── Benefits Grid ── {% endcomment %}
  {%- if section.blocks.size > 0 -%}
    <div
      class="sheva-benefits__grid"
      style="grid-template-columns: repeat(auto-fit, minmax({{ section.settings.min_card_width }}px, 1fr)); gap: {{ section.settings.grid_gap }}px;"
    >
      {%- for block in section.blocks -%}
        {%- if block.type == 'benefit' -%}
          <div
            class="sheva-b-card{% if forloop.index > 4 %} sheva-b-card--hidden{% endif %}"
            style="border-radius: {{ section.settings.card_radius }}px;"
            {{ block.shopify_attributes }}
          >
            <div
              class="sheva-b-icon"
              style="font-size: {{ block.settings.icon_size }}px; border-radius: {{ section.settings.card_radius | minus: 6 }}px;"
            >{{ block.settings.emoji }}</div>
            <h4
              class="sheva-b-card__title"
              style="font-size: {{ section.settings.card_title_fs }}px;"
            >{{ block.settings.title }}</h4>
            <p
              class="sheva-b-card__desc"
              style="font-size: {{ section.settings.card_desc_fs }}px;"
            >{{ block.settings.description }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
    {%- if benefit_blocks.size > 4 -%}
      <div class="sheva-benefits__read-more">
        <button class="sheva-benefits__read-more-btn" aria-expanded="false">
          View All Benefits
        </button>
      </div>
    {%- endif -%}
  {%- endif -%}

</section>

<script>
  (function () {
    var btn = document.querySelector('#sheva-benefits .sheva-benefits__read-more-btn');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var grid = document.querySelector('#sheva-benefits .sheva-benefits__grid');
      grid.classList.add('sheva-benefits__grid--expanded');
    });
  })();
</script>

{% schema %}
{
  "name": "Sheva – Benefits Grid",
  "tag": "section",
  "class": "sheva-section sheva-benefits-section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
