      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "card_title_fs",
      "label": "Card Title Font Size (px)",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "card_desc_fs",
      "label": "Card Description Font Size (px)",
      "min": 10,
      "max": 16,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
