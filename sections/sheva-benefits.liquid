      "label": "Card Hover Shadow Color",
      "default": "#ff4db8"
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "range",
      "id": "min_card_width",
      "label": "Min Card Width (px)",
      "min": 140,
      "max": 280,
      "step": 10,
      "default": 200
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid Gap (px)",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 18
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Border Radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 20
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 40,
      "max": 160,
      "step": 4,
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 40,
      "max": 160,
      "step": 4,
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Card",
      "settings": [
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji / Icon",
          "default": "⚡"
        },
        {
          "type": "text",
