{{ 'sheva-about.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

<style>
  #sheva-about-sourcing-{{ section.id }} {
    --sec-pt: {{ s.padding_top }}px;
    --sec-pb: {{ s.padding_bottom }}px;
    --eyebrow-color: {{ s.eyebrow_color }};
    --eyebrow-fs: {{ s.eyebrow_size }}px;
    --src-title-color: {{ s.title_color }};
    --src-title-fs-desktop: {{ s.title_fs_desktop }}px;
    --src-title-fs-mobile: {{ s.title_fs_mobile }}px;
    --src-desc-color: {{ s.description_color }};
    --src-desc-fs: {{ s.desc_fs }}px;
    --src-bullet-color: {{ s.bullet_color }};
  }
</style>

<section
  id="sheva-about-sourcing-{{ section.id }}"
  class="sheva-about-section abt-source"
>
  <div class="abt-source-left">
    {%- if s.eyebrow != blank -%}
      <span class="sheva-eyebrow eyebrow">
        {{ s.eyebrow }}
      </span>
    {%- endif -%}
    {%- if s.title != blank -%}
      <h2>
        {{ s.title }}
      </h2>
    {%- endif -%}
    {%- if s.description != blank -%}
      <p>
        {{ s.description }}
      </p>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <ul class="abt-checklist">
      {%- for block in section.blocks -%}
        {%- if block.type == 'checklist_item' -%}
          <li {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Sheva — Ethical Sourcing",
  "tag": "section",
  "class": "sheva-section-about-sourcing",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "✦ ETHICAL SOURCING"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Responsible from root to cup"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Sustainability and fair trade are not add-ons — they are how every Sheva Tea® blend is built, supporting the environment and empowering the communities' well-being."
    },
    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow Font Size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_fs_desktop",
      "label": "Title Font Size Desktop (px)",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "title_fs_mobile",
      "label": "Title Font Size Mobile (px)",
      "min": 16,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "desc_fs",
      "label": "Description Font Size (px)",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#22d3ee"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#f3f0ff"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#f3f0ff"
    },
    {
      "type": "color",
      "id": "bullet_color",
      "label": "Star Bullet Glow Color",
      "default": "#22d3ee"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "checklist_item",
      "name": "Checklist Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Organic, ethically sourced botanicals"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sheva — Ethical Sourcing",
      "blocks": [
        {
          "type": "checklist_item",
          "settings": {
            "text": "Organic, ethically sourced botanicals"
          }
        },
        {
          "type": "checklist_item",
          "settings": {
            "text": "Fair trade partnerships with growing communities"
          }
        },
        {
          "type": "checklist_item",
          "settings": {
            "text": "Sustainable, low-impact packaging choices"
          }
        },
        {
          "type": "checklist_item",
          "settings": {
            "text": "Transparent sourcing across every blend"
          }
        }
      ]
    }
  ]
}
{% endschema %}
