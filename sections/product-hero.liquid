{{ 'sheva-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

<style>
  #product-hero-{{ section.id }} {
    --hero-pt: {{ section.settings.padding_top }}px;
    --hero-pb: {{ section.settings.padding_bottom }}px;
  }

  .product-accordions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 20px;
  }

  .sheva-accordion-item {
    background: rgba(12, 4, 34, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.3s, box-shadow 0.3s, background 0.3s;
  }

  .sheva-accordion-item[open] {
    background: rgba(12, 4, 34, 0.85);
    border-color: rgba(34, 211, 238, 0.4);
    box-shadow: 0 0 20px rgba(34, 211, 238, 0.12);
  }

  .sheva-accordion-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background 0.25s;
  }

  .sheva-accordion-header::-webkit-details-marker,
  .sheva-accordion-header::marker {
    display: none;
  }

  .sheva-accordion-header:hover {
    background: rgba(255, 77, 184, 0.08);
  }

  .sheva-accordion-title {
    font-family: var(--sheva-font-heading);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #f3f0ff;
    transition: color 0.25s;
  }

  .sheva-accordion-header:hover .sheva-accordion-title,
  .sheva-accordion-item[open] .sheva-accordion-title {
    color: #22d3ee;
  }

  .sheva-accordion-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #22d3ee;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .sheva-accordion-header:hover .sheva-accordion-icon {
    color: #ff4db8;
  }

  .sheva-accordion-item[open] .sheva-accordion-icon {
    transform: rotate(180deg);
    color: #ff4db8;
  }

  .sheva-accordion-body {
    padding: 0 18px 16px 18px;
    font-family: var(--sheva-font-body);
    font-size: 14px;
    line-height: 1.7;
    color: rgba(243, 240, 255, 0.85);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: 4px;
    padding-top: 12px;
  }

  .sheva-accordion-body p {
    margin-bottom: 8px;
  }

  .sheva-accordion-body p:last-child {
    margin-bottom: 0;
  }

  .sheva-accordion-body a {
    color: #ff4db8;
    text-decoration: underline;
  }

  .sheva-accordion-body a:hover {
    color: #22d3ee;
  }
</style>

<section id="product-hero-{{ section.id }}" class="product-page-hero container-1470">
  <div class="product-page-left">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    <h1>{{ product.title | default: 'Supernova Tea' }}</h1>

    <p class="product-tagline">
      {%- if product.description != blank -%}
        {{ product.description | strip_html }}
      {%- elsif section.settings.tagline != blank -%}
        {{ section.settings.tagline }}
      {%- endif -%}
    </p>

    {%- if section.settings.show_rating -%}
      <div class="rating-row">
        <span class="stars-rating">★★★★★</span>
        <span class="rating-count">{{ section.settings.rating_score }} · {{ section.settings.rating_count }} reviews</span>
      </div>
    {%- endif -%}

    <div class="product-desc">
      {%- if product.metafields.custom.product_inclution != blank -%}
        {{ product.metafields.custom.product_inclution | metafield_tag }}
      {%- else -%}
        {{ section.settings.product_desc }}
      {%- endif -%}
    </div>

    {%- comment -%} Styled Add to Cart Form {%- endcomment -%}
    {%- if product != blank -%}
      {%- assign product_form_id = 'product-form-' | append: product.id -%}
      <product-form class="productView-form product-form">
        {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          
          <input type="hidden" name="id" value="{{ current_variant.id }}" class="product-variant-id">

          <div class="qty-row">
            <div class="qty">
              <button type="button" class="minus">−</button>
              <span class="qval">1</span>
              <button type="button" class="plus">+</button>
              <input type="hidden" name="quantity" class="qty-input" value="1" />
            </div>

            {%- assign allow_oversell = false -%}
            {%- if current_variant.inventory_management == blank or current_variant.inventory_policy == 'continue' -%}
              {%- assign allow_oversell = true -%}
            {%- endif -%}

            <button 
              type="submit" 
              name="add" 
              id="product-add-to-cart"
              data-btn-addtocart
              data-inventory-quantity="{{ current_variant.inventory_quantity | default: 0 }}"
              data-available="{{ allow_oversell }}"
              class="btn-primary add-cart product-form__submit"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available -%}
                Add to Cart — $<span class="cart-price">{{ current_variant.price | money_without_currency }}</span>
              {%- else -%}
                Sold Out
              {%- endif -%}
            </button>
          </div>

        {%- endform -%}
      </product-form>
    {%- endif -%}

    {%- if section.settings.shipping_note != blank -%}
      <p class="shipping">{{ section.settings.shipping_note }}</p>
    {%- endif -%}

    {%- if product.metafields.custom.icon_and_texts != blank -%}
      {%- assign icon_list = product.metafields.custom.icon_and_texts.value -%}
      <div class="sheva-fp__icons-row">
        {%- for item in icon_list -%}
          {%- assign item_parts = item | split: '::' -%}
          {%- assign icon_val = item_parts[0] | strip -%}
          {%- assign label_val = item_parts[1] | strip -%}
          {%- if icon_val != blank or label_val != blank -%}
            <div class="sheva-fp__icon-item">
              <div class="sheva-fp__icon">
                {%- if icon_val contains 'http://' or icon_val contains 'https://' or icon_val contains '//cdn.shopify.com' or icon_val contains '.png' or icon_val contains '.svg' or icon_val contains '.jpg' or icon_val contains '.webp' -%}
                  <img src="{{ icon_val }}" alt="{{ label_val | escape }}" loading="lazy" class="sheva-fp__icon-img">
                {%- else -%}
                  {{ icon_val }}
                {%- endif -%}
              </div>
              {%- if label_val != blank -%}
                <span>{{ label_val }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Accordion Blocks (Rendered below .shipping when description is added) {%- endcomment -%}
    {%- assign accordion_blocks = section.blocks | where: 'type', 'accordion' -%}
    {%- if accordion_blocks.size > 0 -%}
      <div class="product-accordions">
        {%- for block in accordion_blocks -%}
          {%- if block.settings.description != blank -%}
            <details class="sheva-accordion-item" {{ block.shopify_attributes }}>
              <summary class="sheva-accordion-header">
                <span class="sheva-accordion-title">{{ block.settings.title | escape }}</span>
                <span class="sheva-accordion-icon">
                  <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </span>
              </summary>
              <div class="sheva-accordion-body rte">
                {{ block.settings.description }}
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-page-right">
    <div class="product-page-orb"></div>
    {%- if product.featured_image != blank -%}
      <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title | escape }}" class="product-page-image" />
    {%- endif -%}
  </div>
</section>

<script>
(function() {
  function initProductHero(section) {
    var cartPrice = section.querySelector('.cart-price');
    var qtyVal = section.querySelector('.qval');
    var qtyInput = section.querySelector('.qty-input');
    var plusBtn = section.querySelector('.plus');
    var minusBtn = section.querySelector('.minus');

    {% assign current_price = current_variant.price | divided_by: 100.0 %}
    var currentPrice = {{ current_price }};
    var qty = 1;

    if (plusBtn) {
      plusBtn.addEventListener('click', function () {
        qty++;
        if (qtyVal) qtyVal.textContent = qty;
        if (qtyInput) qtyInput.value = qty;
        updatePrice();
      });
    }

    if (minusBtn) {
      minusBtn.addEventListener('click', function () {
        if (qty > 1) {
          qty--;
          if (qtyVal) qtyVal.textContent = qty;
          if (qtyInput) qtyInput.value = qty;
          updatePrice();
        }
      });
    }

    function updatePrice() {
      if (cartPrice) {
        cartPrice.textContent = (currentPrice * qty).toFixed(2);
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.product-page-hero').forEach(initProductHero);
    });
  } else {
    document.querySelectorAll('.product-page-hero').forEach(initProductHero);
  }

  document.addEventListener('shopify:section:load', function(e) {
    var section = e.target.querySelector('.product-page-hero');
    if (section) initProductHero(section);
  });
})();
</script>

{% schema %}
{
  "name": "Product Hero",
  "tag": "section",
  "class": "product-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "✦ SEVEN STAR ENERGY®"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "A cosmic herbal blend crafted to elevate energy, clarity, and calm."
    },
    {
      "type": "textarea",
      "id": "product_desc",
      "label": "Custom Description",
      "default": "Net Wt 2oz Loose Leaf (56g) · 30 Servings. An otherworldly blend of ancient herbs to boost energy, clarity, and cosmic balance."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Review Count",
      "default": "2,143"
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Shipping Note",
      "default": "🚀 FREE Shipping when you spend over $50"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ingredients & Usage"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Ancient loose-leaf herbs blended for cosmic balance. Steep 1-2 tsp in hot water for 5-7 minutes.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Hero",
      "blocks": [
        {
          "type": "accordion",
          "settings": {
            "title": "Ingredients & Usage",
            "description": "<p>Ancient loose-leaf herbs blended for cosmic balance. Steep 1-2 tsp in hot water for 5-7 minutes.</p>"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Shipping & Guarantee",
            "description": "<p>Free worldwide shipping over $50. 100% satisfaction guarantee with 30-day returns.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
