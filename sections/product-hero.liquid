{{ 'sheva-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

<style>
  #product-hero-{{ section.id }} {
    --hero-pt: {{ section.settings.padding_top }}px;
    --hero-pb: {{ section.settings.padding_bottom }}px;
  }

  /* Price Display Below Rating Row */
  .product-hero__price-wrapper {
    margin: 16px 0 20px;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .product-hero__price {
    font-family: var(--sheva-font-heading);
    font-size: clamp(18px, 3vw, 26px);
    font-weight: 700;
    color: #22d3ee;
    text-shadow: 0 0 15px rgba(34, 211, 238, 0.4);
    letter-spacing: 1px;
  }

  .product-hero__compare-price {
    font-family: var(--sheva-font-body);
    font-size: clamp(14px, 2vw, 18px);
    color: rgba(243, 240, 255, 0.5);
    text-decoration: line-through;
  }

  /* Custom Variant Picker Styling */
  .custom-variant-picker {
    margin: 20px 0 26px 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .custom-variant-option {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .custom-option-label {
    font-family: var(--sheva-font-heading);
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #f3f0ff;
  }

  .custom-option-selected-val {
    color: #22d3ee;
    font-weight: 600;
    margin-left: 6px;
    text-transform: none;
  }

  .custom-option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .custom-variant-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 22px;
    border-radius: 999px;
    background: rgba(12, 4, 34, 0.7);
    border: 1.5px solid rgba(255, 255, 255, 0.18);
    color: #f3f0ff;
    font-family: var(--sheva-font-body);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(8px);
    user-select: none;
  }

  .custom-variant-btn:hover {
    border-color: rgba(34, 211, 238, 0.6);
    background: rgba(34, 211, 238, 0.12);
    transform: translateY(-2px);
  }

  .custom-variant-btn.active {
    border-color: #22d3ee;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.25), rgba(255, 77, 184, 0.25));
    box-shadow: 0 0 20px rgba(34, 211, 238, 0.4), inset 0 0 10px rgba(34, 211, 238, 0.2);
    color: #ffffff;
    font-weight: 700;
  }

  .custom-variant-btn.sold-out {
    opacity: 0.5;
    text-decoration: line-through;
    border-style: dashed;
  }

  .custom-soldout-tag {
    font-size: 11px;
    color: #ff4db8;
    margin-left: 4px;
  }

  .product-hero__app-block {
    margin: 18px 0 24px;
  }

  .product-accordions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 20px;
  }

  .sheva-accordion-item {
    background: rgba(12, 4, 34, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.3s, box-shadow 0.3s, background 0.3s;
  }

  .sheva-accordion-item[open] {
    background: rgba(12, 4, 34, 0.85);
    border-color: rgba(34, 211, 238, 0.4);
    box-shadow: 0 0 20px rgba(34, 211, 238, 0.12);
  }

  .sheva-accordion-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background 0.25s;
  }

  .sheva-accordion-header::-webkit-details-marker,
  .sheva-accordion-header::marker {
    display: none;
  }

  .sheva-accordion-header:hover {
    background: rgba(255, 77, 184, 0.08);
  }

  .sheva-accordion-title {
    font-family: var(--sheva-font-heading);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #f3f0ff;
    transition: color 0.25s;
  }

  .sheva-accordion-header:hover .sheva-accordion-title,
  .sheva-accordion-item[open] .sheva-accordion-title {
    color: #22d3ee;
  }

  .sheva-accordion-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #22d3ee;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .sheva-accordion-header:hover .sheva-accordion-icon {
    color: #ff4db8;
  }

  .sheva-accordion-item[open] .sheva-accordion-icon {
    transform: rotate(180deg);
    color: #ff4db8;
  }

  .sheva-accordion-body {
    padding: 0 18px 16px 18px;
    font-family: var(--sheva-font-body);
    font-size: 14px;
    line-height: 1.7;
    color: rgba(243, 240, 255, 0.85);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: 4px;
    padding-top: 12px;
  }

  .sheva-accordion-body p {
    margin-bottom: 8px;
  }

  .sheva-accordion-body p:last-child {
    margin-bottom: 0;
  }

  .sheva-accordion-body a {
    color: #ff4db8;
    text-decoration: underline;
  }

  .sheva-accordion-body a:hover {
    color: #22d3ee;
  } 
  .subscription_group .title_and_price_wrapper > *{color:#fff !important}
  .subscription_group .group_dropdown {
    padding: 18px 10px;
    font-size: 14px;
    color: #fff;
  }
  .subscription_group .group_dropdown option{
    color:#000 !important
  }
  .subscription_group .shopify_subscriptions_app_policy{color:#fff !important;}
</style>

<section id="product-hero-{{ section.id }}" class="product-page-hero">
  <div class="product-page-left">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    <h1>{{ product.title | default: 'Supernova Tea' }}</h1>

    <p class="product-tagline">
      {%- if product.description != blank -%}
        {{ product.description | strip_html }}
      {%- elsif section.settings.tagline != blank -%}
        {{ section.settings.tagline }}
      {%- endif -%}
    </p>

    {%- if section.settings.show_rating -%}
      <div class="rating-row">
        <span class="stars-rating">★★★★★</span>
        <span class="rating-count">{{ section.settings.rating_score }} · {{ section.settings.rating_count }} reviews</span>
      </div>
    {%- endif -%}

    {%- comment -%} Product Price Display (below rating-row) {%- endcomment -%}
    <div class="product-hero__price-wrapper" id="product-price-{{ product.id }}">
      <span class="product-hero__price money" data-product-hero-price>
        {{ current_variant.price | money }}
      </span>
      <s class="product-hero__compare-price money" data-product-hero-compare-price style="{% unless current_variant.compare_at_price > current_variant.price %}display:none;{% endunless %}">
        {%- if current_variant.compare_at_price > current_variant.price -%}
          {{ current_variant.compare_at_price | money }}
        {%- endif -%}
      </s>
    </div>

    <div class="product-desc">
      {%- if product.metafields.custom.product_inclution != blank -%}
        {{ product.metafields.custom.product_inclution | metafield_tag }}
      {%- else -%}
        {{ section.settings.product_desc }}
      {%- endif -%}
    </div>

    {%- comment -%} Styled Add to Cart Form {%- endcomment -%}
    {%- if product != blank -%}
      {%- assign product_form_id = 'product-form-' | append: product.id -%}
      <product-form class="productView-form product-form">
        {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          
          <input type="hidden" name="id" value="{{ current_variant.id }}" class="product-variant-id">

          {%- comment -%} Custom Variant Picker {%- endcomment -%}
          {%- if product.has_only_default_variant != true and product.options_with_values.size > 0 -%}
            <div class="custom-variant-picker" data-section-id="{{ section.id }}">
              {%- for option in product.options_with_values -%}
                {%- assign option_index = forloop.index0 -%}
                <div class="custom-variant-option" data-option-index="{{ option_index }}">
                  <label class="custom-option-label">
                    {{ option.name }}: <span class="custom-option-selected-val">{{ option.selected_value }}</span>
                  </label>
                  <div class="custom-option-values">
                    {%- for value in option.values -%}
                      {%- assign value_available = false -%}
                      {%- for variant in product.variants -%}
                        {%- if variant.options[option_index] == value and variant.available -%}
                          {%- assign value_available = true -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}

                      <button
                        type="button"
                        class="custom-variant-btn{% if option.selected_value == value %} active{% endif %}{% unless value_available %} sold-out{% endunless %}"
                        data-option-name="{{ option.name | escape }}"
                        data-option-value="{{ value | escape }}"
                        data-option-index="{{ option_index }}"
                      >
                        <span class="custom-btn-text">{{ value }}</span>
                        {%- unless value_available -%}
                          <span class="custom-soldout-tag">(Sold Out)</span>
                        {%- endunless -%}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>

            <script type="application/json" class="custom-product-variants-json">
              {{ product.variants | json }}
            </script>
          {%- endif -%}

          {%- comment -%} Render App Blocks (Subscription Widgets, etc.) {%- endcomment -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                <div class="product-hero__app-block" {{ block.shopify_attributes }}>
                  {% render block %}
                </div>
            {%- endcase -%}
          {%- endfor -%}

          <div class="qty-row">
            <div class="qty">
              <button type="button" class="minus">−</button>
              <span class="qval">1</span>
              <button type="button" class="plus">+</button>
              <input type="hidden" name="quantity" class="qty-input" value="1" />
            </div>

            {%- assign allow_oversell = false -%}
            {%- if current_variant.inventory_management == blank or current_variant.inventory_policy == 'continue' -%}
              {%- assign allow_oversell = true -%}
            {%- endif -%}

            <button 
              type="submit" 
              name="add" 
              id="product-add-to-cart"
              data-btn-addtocart
              data-inventory-quantity="{{ current_variant.inventory_quantity | default: 0 }}"
              data-available="{{ allow_oversell }}"
              class="btn-primary add-cart product-form__submit"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available -%}
                Add to Cart
              {%- else -%}
                Sold Out
              {%- endif -%}
            </button>
          </div>

        {%- endform -%}
      </product-form>
    {%- endif -%}

    {%- if section.settings.shipping_note != blank -%}
      <p class="shipping">{{ section.settings.shipping_note }}</p>
    {%- endif -%}

    {%- if product.metafields.custom.icon_and_texts != blank -%}
      {%- assign icon_list = product.metafields.custom.icon_and_texts.value -%}
      <div class="sheva-fp__icons-row">
        {%- for item in icon_list -%}
          {%- assign item_parts = item | split: '::' -%}
          {%- assign icon_val = item_parts[0] | strip -%}
          {%- assign label_val = item_parts[1] | strip -%}
          {%- if icon_val != blank or label_val != blank -%}
            <div class="sheva-fp__icon-item">
              <div class="sheva-fp__icon">
                {%- if icon_val contains 'http://' or icon_val contains 'https://' or icon_val contains '//cdn.shopify.com' or icon_val contains '.png' or icon_val contains '.svg' or icon_val contains '.jpg' or icon_val contains '.webp' -%}
                  <img src="{{ icon_val }}" alt="{{ label_val | escape }}" loading="lazy" class="sheva-fp__icon-img">
                {%- else -%}
                  {{ icon_val }}
                {%- endif -%}
              </div>
              {%- if label_val != blank -%}
                <span>{{ label_val }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Accordion Blocks (Rendered below .shipping when description is added) {%- endcomment -%}
    {%- assign accordion_blocks = section.blocks | where: 'type', 'accordion' -%}
    {%- if accordion_blocks.size > 0 -%}
      <div class="product-accordions">
        {%- for block in accordion_blocks -%}
          {%- if block.settings.description != blank -%}
            <details class="sheva-accordion-item" {{ block.shopify_attributes }}>
              <summary class="sheva-accordion-header">
                <span class="sheva-accordion-title">{{ block.settings.title | escape }}</span>
                <span class="sheva-accordion-icon">
                  <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </span>
              </summary>
              <div class="sheva-accordion-body rte">
                {{ block.settings.description }}
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-page-right">
    <div class="pgal" id="pgal-{{ section.id }}">
      <div class="pgal-stage">
        <div class="pgal-aura" aria-hidden="true"></div>
        <div class="pgal-ring" aria-hidden="true"></div>

        <div class="pgal-viewport" id="pgalViewport-{{ section.id }}" role="region" aria-label="{{ product.title | default: 'Product gallery' | escape }}" aria-live="polite">
          {%- liquid
            assign media_list = product.media
            if media_list == blank or media_list.size == 0
              assign media_list = product.images
            endif
          -%}

          {%- if media_list.size > 0 -%}
            {%- for media in media_list -%}
              {%- assign is_photo = false -%}
              {%- if media.alt contains 'photo' or media.alt contains 'ritual' or media.alt contains 'journey' -%}
                {%- assign is_photo = true -%}
              {%- endif -%}
              <figure class="pgal-slide {% if is_photo %}is-photo{% else %}is-cutout{% endif %}{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" data-media-id="{{ media.id }}">
                {%- case media.media_type -%}
                  {%- when 'image' or blank -%}
                    <img
                      src="{{ media | img_url: '1200x' }}"
                      srcset="{{ media | img_url: '600x' }} 600w, {{ media | img_url: '900x' }} 900w, {{ media | img_url: '1200x' }} 1200w"
                      sizes="(min-width: 1024px) 560px, 90vw"
                      alt="{{ media.alt | default: product.title | escape }}"
                      {% unless forloop.first %}loading="lazy"{% endunless %}
                    />
                  {%- when 'video' -%}
                    {{ media | video_tag: controls: true, class: 'pgal-video' }}
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag: class: 'pgal-video' }}
                  {%- when 'model' -%}
                    {{ media | model_viewer_tag }}
                  {%- else -%}
                    {{ media | media_tag }}
                {%- endcase -%}
              </figure>
            {%- endfor -%}
          {%- elsif product.featured_image != blank -%}
            <figure class="pgal-slide is-cutout is-active" data-index="0" data-media-id="{{ product.featured_image.id }}">
              <img src="{{ product.featured_image | img_url: '1200x' }}" alt="{{ product.title | escape }}" />
            </figure>
          {%- endif -%}
        </div>

        {%- assign total_slides = media_list.size -%}
        {%- if total_slides == 0 and product.featured_image != blank -%}
          {%- assign total_slides = 1 -%}
        {%- endif -%}

        {%- if total_slides > 1 -%}
          <button class="pgal-nav prev" id="pgalPrev-{{ section.id }}" type="button" aria-label="Previous image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg>
          </button>
          <button class="pgal-nav next" id="pgalNext-{{ section.id }}" type="button" aria-label="Next image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
          </button>
        {%- endif -%}
      </div>

      {%- if total_slides > 1 -%}
        <div class="pgal-thumbs" id="pgalThumbs-{{ section.id }}" role="tablist" aria-label="Choose a product view" style="--thumb-count: {{ total_slides | at_most: 5 }};">
          {%- if media_list.size > 0 -%}
            {%- for media in media_list -%}
              <button class="pgal-thumb{% if forloop.first %} is-active{% endif %}" type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-index="{{ forloop.index0 }}">
                <img src="{{ media | img_url: '300x' }}" alt="{{ media.alt | default: product.title | escape }}" loading="lazy" />
              </button>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
(function() {
  function initProductHero(section) {
    var qtyVal = section.querySelector('.qval');
    var qtyInput = section.querySelector('.qty-input');
    var plusBtn = section.querySelector('.plus');
    var minusBtn = section.querySelector('.minus');

    var priceEl = section.querySelector('[data-product-hero-price]');
    var comparePriceEl = section.querySelector('[data-product-hero-compare-price]');
    var variantInput = section.querySelector('.product-variant-id');
    var atcBtn = section.querySelector('#product-add-to-cart');

    var variantsJsonEl = section.querySelector('.custom-product-variants-json');
    var variantsData = [];
    if (variantsJsonEl) {
      try {
        variantsData = JSON.parse(variantsJsonEl.textContent);
      } catch(e) {}
    }

    var qty = 1;

    // Determine currently selected variant
    var currentVariantId = variantInput ? variantInput.value : null;
    var selectedVariant = variantsData.find(function(v) {
      return v.id == currentVariantId;
    }) || variantsData[0];

    function formatMoney(cents) {
      if (window.Shopify && typeof Shopify.formatMoney === 'function' && window.money_format) {
        try {
          return Shopify.formatMoney(cents * qty, window.money_format);
        } catch(e) {}
      }
      return '$' + ((cents * qty) / 100).toFixed(2);
    }

    // Initialize Gallery Slider
    var gal = section.querySelector('.pgal');
    if (gal) {
      var slides = Array.prototype.slice.call(gal.querySelectorAll('.pgal-slide'));
      var thumbs = Array.prototype.slice.call(gal.querySelectorAll('.pgal-thumb'));
      var prevBtn = gal.querySelector('.pgal-nav.prev');
      var nextBtn = gal.querySelector('.pgal-nav.next');
      var viewport = gal.querySelector('.pgal-viewport');
      var currentSlide = 0;

      if (slides.length <= 1) {
        if (prevBtn) prevBtn.style.display = 'none';
        if (nextBtn) nextBtn.style.display = 'none';
        var thumbsWrap = gal.querySelector('.pgal-thumbs');
        if (thumbsWrap) thumbsWrap.style.display = 'none';
      }

      function goToSlide(next) {
        if (slides.length <= 1) return;
        next = (next + slides.length) % slides.length;
        if (next === currentSlide) return;

        slides[currentSlide].classList.remove('is-active');
        if (thumbs[currentSlide]) {
          thumbs[currentSlide].classList.remove('is-active');
          thumbs[currentSlide].setAttribute('aria-selected', 'false');
        }

        currentSlide = next;

        slides[currentSlide].classList.add('is-active');
        if (thumbs[currentSlide]) {
          thumbs[currentSlide].classList.add('is-active');
          thumbs[currentSlide].setAttribute('aria-selected', 'true');
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          goToSlide(currentSlide - 1);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          goToSlide(currentSlide + 1);
        });
      }

      thumbs.forEach(function(btn, idx) {
        btn.addEventListener('click', function() {
          goToSlide(idx);
        });
      });

      gal.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          goToSlide(currentSlide - 1);
          if (thumbs[currentSlide]) thumbs[currentSlide].focus();
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          goToSlide(currentSlide + 1);
          if (thumbs[currentSlide]) thumbs[currentSlide].focus();
        }
      });

      if (viewport) {
        var x0 = null, y0 = null;
        viewport.addEventListener('touchstart', function(e) {
          x0 = e.touches[0].clientX;
          y0 = e.touches[0].clientY;
        }, { passive: true });

        viewport.addEventListener('touchend', function(e) {
          if (x0 === null) return;
          var dx = e.changedTouches[0].clientX - x0;
          var dy = e.changedTouches[0].clientY - y0;
          if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) {
            goToSlide(currentSlide + (dx < 0 ? 1 : -1));
          }
          x0 = null;
          y0 = null;
        }, { passive: true });
      }

      // Preload neighbouring images
      slides.forEach(function(s) {
        var img = s.querySelector('img');
        if (img) img.loading = 'eager';
      });

      // Synchronize with variant change
      section._goToSlideForVariant = function(variant) {
        if (!variant || slides.length <= 1) return;
        var targetIndex = -1;
        if (variant.featured_media) {
          targetIndex = slides.findIndex(function(s) {
            return s.getAttribute('data-media-id') == variant.featured_media.id;
          });
        }
        if (targetIndex === -1 && variant.featured_image) {
          targetIndex = slides.findIndex(function(s) {
            var img = s.querySelector('img');
            return img && img.src.indexOf(variant.featured_image.src.split('?')[0]) !== -1;
          });
        }
        if (targetIndex !== -1) {
          goToSlide(targetIndex);
        }
      };
    }

    function updateDisplay() {
      if (!selectedVariant) return;

      // Update hidden input ID for add to cart form
      if (variantInput) variantInput.value = selectedVariant.id;

      // Update main product price below .rating-row
      if (priceEl) {
        priceEl.innerHTML = formatMoney(selectedVariant.price);
      }

      // Update compare-at price if applicable
      if (comparePriceEl) {
        if (selectedVariant.compare_at_price && selectedVariant.compare_at_price > selectedVariant.price) {
          comparePriceEl.innerHTML = formatMoney(selectedVariant.compare_at_price);
          comparePriceEl.style.display = 'inline-block';
        } else {
          comparePriceEl.style.display = 'none';
        }
      }

      // Update Add to Cart Button state
      if (atcBtn) {
        if (selectedVariant.available) {
          atcBtn.removeAttribute('disabled');
          atcBtn.textContent = 'Add to Cart';
        } else {
          atcBtn.setAttribute('disabled', 'disabled');
          atcBtn.textContent = 'Sold Out';
        }
      }

      // Switch gallery image if variant has its own image
      if (typeof section._goToSlideForVariant === 'function') {
        section._goToSlideForVariant(selectedVariant);
      }
    }

    // Quantity Handlers
    if (plusBtn) {
      plusBtn.addEventListener('click', function () {
        qty++;
        if (qtyVal) qtyVal.textContent = qty;
        if (qtyInput) qtyInput.value = qty;
        updateDisplay();
      });
    }

    if (minusBtn) {
      minusBtn.addEventListener('click', function () {
        if (qty > 1) {
          qty--;
          if (qtyVal) qtyVal.textContent = qty;
          if (qtyInput) qtyInput.value = qty;
          updateDisplay();
        }
      });
    }

    // Custom Variant Selection Buttons Click Listener
    var optionBlocks = section.querySelectorAll('.custom-variant-option');
    optionBlocks.forEach(function(block) {
      var buttons = block.querySelectorAll('.custom-variant-btn');
      var labelVal = block.querySelector('.custom-option-selected-val');

      buttons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          // Deselect sibling buttons in this option group
          buttons.forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');

          if (labelVal) {
            labelVal.textContent = btn.getAttribute('data-option-value');
          }

          // Gather all current option selections
          var currentSelections = [];
          optionBlocks.forEach(function(ob) {
            var activeBtn = ob.querySelector('.custom-variant-btn.active');
            if (activeBtn) {
              currentSelections.push(activeBtn.getAttribute('data-option-value'));
            }
          });

          // Match corresponding variant from JSON
          var match = variantsData.find(function(v) {
            return v.options.every(function(optVal, idx) {
              return optVal === currentSelections[idx];
            });
          });

          if (match) {
            selectedVariant = match;
            updateDisplay();
          }
        });
      });
    });

    // Run initial display update
    updateDisplay();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.product-page-hero').forEach(initProductHero);
    });
  } else {
    document.querySelectorAll('.product-page-hero').forEach(initProductHero);
  }

  document.addEventListener('shopify:section:load', function(e) {
    var section = e.target.querySelector('.product-page-hero');
    if (section) initProductHero(section);
  });
})();
</script>

